DB_HOST=localhost
DB_NAME=clinica_db
DB_USER=root
DB_PASSWORD=tu_contrasena_aqui
DB_PORT=3306

# Configuración de Sesión y Seguridad (opcional)
APP_ENV=local
APP_SECRET_KEY=clave_secreta_de_prueba